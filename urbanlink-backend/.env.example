NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=urbanlink
DB_USER=urbanlink_app
DB_PASSWORD=troque-pela-senha-do-usuario-mysql
# Use true quando o MySQL estiver na nuvem e exigir conexão segura (TLS).
DB_SSL=false

# Gere valores próprios com: npm run secrets:generate
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h
PII_ENCRYPTION_KEY=troque-por-64-caracteres-hexadecimais

# Origens autorizadas para o front-end. Separe várias com vírgula.
# Na Vercel, se esta variável não for cadastrada, o próprio endereço do projeto é usado.
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
# Na Vercel, se esta variável não for cadastrada, vale true automaticamente.
TRUST_PROXY=false
DB_LOGGING=false
AUTH_RATE_LIMIT_MAX=10
PUBLIC_FORM_RATE_LIMIT_MAX=8
