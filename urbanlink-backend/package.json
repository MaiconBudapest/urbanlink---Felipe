{
  "name": "urbanlink-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST da plataforma UrbanLink baseada em Express, Sequelize e MySQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "admin:create": "node scripts/create-admin.js",
    "secrets:generate": "node scripts/generate-secrets.js",
    "test": "node --test test/unit/*.test.js test/integration/*.test.js",
    "test:integration": "node --test test/integration/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.5",
    "sequelize": "^6.37.7",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "sequelize-cli": "6.6.2"
  },
  "overrides": {
    "sequelize": {
      "uuid": "^11.1.1"
    },
    "glob": "^14.0.6",
    "minimatch": "^11.0.8"
  }
}
